#!/usr/bin/env bash
# Windroid first boot (root, oneshot via windroid-firstboot.service).
# Runs on the binder-enabled kernel, so `waydroid init` can succeed here —
# it cannot at image-build time (docs/UPSTREAM-FACTS.md §5). Idempotent:
# stamps /var/lib/windroid/.initialized on success.
set -euo pipefail

STAMP_DIR=/var/lib/windroid
STAMP="$STAMP_DIR/.initialized"
CONF=/etc/windroid/windroid.conf
LOG=/var/log/windroid-firstboot.log

exec > >(tee -a "$LOG") 2>&1
# The installer owns configuration. Importing/booting a distro must not
# select VANILLA before the Windows -Gapps option has reached this file.
[[ -e /etc/windroid/.configured ]] || { echo "waiting for installer configuration"; exit 0; }
mkdir -p "$STAMP_DIR"
exec 9>"$STAMP_DIR/firstboot.lock"
flock -x 9
# shellcheck source=/dev/null
source "$CONF"
flavour=VANILLA
[[ "${GAPPS:-false}" == true ]] && flavour=GAPPS
if [[ -f "$STAMP" && "$(cat "$STAMP")" == "$flavour" ]]; then
    echo "already initialized ($flavour)"
    exit 0
fi
# Legacy stamps were empty. Re-run init after the installer has stopped
# the legacy auto-start service; an empty stamp cannot prove image flavour.

echo "== windroid-firstboot $(date -Is) kernel=$(uname -r)"

# 1. Binder sanity — fail loudly and early if the custom kernel isn't active.
if ! zgrep -q '^CONFIG_ANDROID_BINDER_IPC=y' /proc/config.gz 2>/dev/null; then
    echo "FATAL: kernel has no binder support — is the Windroid kernel set in .wslconfig?"
    exit 1
fi

# 2. Rendering override BEFORE init: the [properties] section of
# waydroid.cfg is merged into waydroid_base.prop whenever init/upgrade
# regenerates it — the supported override channel, unlike editing
# waydroid_base.prop directly (UPSTREAM-FACTS §5). waydroid.cfg may not
# exist yet; init preserves an existing file's sections.
mkdir -p /var/lib/waydroid
python3 - /var/lib/waydroid/waydroid.cfg "${FORCE_SOFTWARE_RENDERING:-false}" "${MULTI_WINDOWS:-true}" <<'PYCFG'
import configparser
import sys

path, software, multi = sys.argv[1:]
# Legacy text edits may already have inserted duplicate options. Normalize
# them once, then write each setting exactly once using Waydroid's INI format.
cfg = configparser.ConfigParser(strict=False, interpolation=None)
cfg.read(path)
for section in ("properties", "waydroid"):
    if not cfg.has_section(section):
        cfg.add_section(section)
if software == "true":
    cfg.set("properties", "ro.hardware.gralloc", "default")
    cfg.set("properties", "ro.hardware.egl", "swiftshader")
cfg.set("properties", "persist.waydroid.multi_windows", "true" if multi == "true" else "false")
cfg.set("waydroid", "suspend_action", "none")
with open(path + ".tmp", "w") as output:
    cfg.write(output)
import os
os.replace(path + ".tmp", path)
PYCFG

# 3. Init. VANILLA path uses the preseeded images in
# /etc/waydroid-extra/images (init checks that dir first and skips all
# downloads). GAPPS must NOT see the preseeded vanilla images — the
# preinstalled check wins over -s — so park them and download GAPPS here,
# on the user's machine only (ADR-004).
if [[ "${GAPPS:-false}" == "true" ]]; then
    preseed_type="$(cat /etc/waydroid-extra/images/.system-type 2>/dev/null || echo VANILLA)"
    if [[ "$preseed_type" == "GAPPS" ]]; then
        # Local gapps rootfs build: the preseeded images ARE the GAPPS
        # images — use them directly, no re-download.
        waydroid --details-to-stdout init
    else
        if [[ -d /etc/waydroid-extra/images ]]; then
            echo "GAPPS requested: setting aside preseeded VANILLA images"
            if [[ -e /etc/waydroid-extra/images.vanilla-preseed ]]; then
                echo "FATAL: both active and parked preseed directories exist; inspect before retrying" >&2
                exit 1
            fi
            mv /etc/waydroid-extra/images "/etc/waydroid-extra/images.vanilla-preseed"
        fi
        waydroid --details-to-stdout init -f -s GAPPS
    fi
else
    waydroid --details-to-stdout init
fi

# Rebuild derived props after normalizing the supported [properties] overrides.
waydroid upgrade --offline

systemctl enable waydroid-container.service

printf '%s\n' "$flavour" > "$STAMP.tmp"
mv -f "$STAMP.tmp" "$STAMP"
echo "== windroid-firstboot done"
