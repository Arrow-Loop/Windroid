#!/usr/bin/env bash
# Windroid session control (run as the desktop user, NOT root).
#   windroid-session start|stop|status|ensure
#
# Start order and quirks are prior-art-proven (docs/UPSTREAM-FACTS.md §6):
# modprobe one module per call, container first (root, via systemd),
# then the user session; check the ready log and live Android framework.
set -euo pipefail

CONF=/etc/windroid/windroid.conf
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/windroid"
SESSION_LOG="$LOG_DIR/session.log"
WESTON_LOG="$LOG_DIR/nested-weston.log"
# shellcheck source=/dev/null
source "$CONF"
READY_TIMEOUT="${SESSION_READY_TIMEOUT:-180}"
if [[ ! "$READY_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || (( READY_TIMEOUT > 600 )); then
    echo 'SESSION_READY_TIMEOUT must be an integer from 1 to 600 seconds' >&2
    exit 2
fi
mkdir -p "$LOG_DIR"

# Serialize lifecycle requests from simultaneous Start Menu/CLI/tray launches.
# Detached children below must close this descriptor rather than holding the
# lifecycle lock for the entire Android session.
case "${1:-}" in
    start|ensure|stop)
        exec 9>"$LOG_DIR/session.lock"
        flock -x -w "$READY_TIMEOUT" 9 || { echo 'Timed out waiting for another session operation' >&2; exit 1; }
        ;;
esac

ensure_host_plumbing() {
    # All root-side work (shared_memory tmpfs, net modules, container
    # start) lives in one sudoers-whitelisted helper.
    sudo -n /usr/local/sbin/windroid-prep up
}

session_running() {
    local status
    status="$(waydroid status 2>/dev/null)" || return 1
    grep -q 'Session:[[:space:]]*RUNNING' <<< "$status" &&
        grep -q 'Container:[[:space:]]*RUNNING' <<< "$status"
}

nested_weston_running() {
    pgrep -u "$(id -u)" -f 'weston --backend=wayland-backend' >/dev/null
}

android_ready() {
    # The log survives framework/compositor restarts. Query the live platform
    # and PackageManager as the session user instead of trusting an old line.
    # Waydroid may log an IPC error and still exit zero, so require app data.
    local apps max_wait="$1"
    (( max_wait > 0 )) || return 1
    if (( max_wait > 5 )); then max_wait=5; fi
    grep -q 'is ready' "$SESSION_LOG" 2>/dev/null || return 1
    apps="$(timeout -k 1 "$max_wait" waydroid app list 2>/dev/null)" || return 1
    grep -q '^packageName:' <<< "$apps"
}

start() {
    local ready_deadline
    if session_running; then
        ready_deadline=$((SECONDS + READY_TIMEOUT))
        if android_ready "$((ready_deadline - SECONDS))"; then
            echo "session already RUNNING"
            return 0
        fi
        echo 'session is running; waiting for Android readiness'
    else
    ensure_host_plumbing

    if [[ "${NESTED_WESTON:-false}" == "true" ]]; then
        # Prior-art fallback: nest a Weston so Waydroid never talks to
        # WSLg's RDP compositor directly (stuck 1x1 buffer bug).
        local weston_pid=''
        local weston_socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wayland-1"
        for _ in $(seq "$READY_TIMEOUT"); do
            if [[ -n "$weston_pid" ]] && ! kill -0 "$weston_pid" 2>/dev/null; then
                echo "ERROR: nested Weston exited before creating $weston_socket" >&2
                tail -n 20 "$WESTON_LOG" >&2
                return 1
            fi
            # An existing compositor can be finishing a previous shutdown.
            # Recheck while waiting, instead of waiting for its lost socket
            # for the entire timeout without ever launching a replacement.
            if [[ -z "$weston_pid" ]] && ! nested_weston_running; then
                WAYLAND_DISPLAY=wayland-0 setsid nohup weston \
                    --backend=wayland-backend.so --socket=wayland-1 --width=1280 --height=800 \
                    > "$WESTON_LOG" 2>&1 < /dev/null 9>&- &
                weston_pid=$!
            fi
            [[ -S "$weston_socket" ]] && break
            sleep 1
        done
        if [[ ! -S "$weston_socket" ]]; then
            echo "ERROR: nested Weston socket not ready after ${READY_TIMEOUT}s" >&2
            tail -n 20 "$WESTON_LOG" >&2
            return 1
        fi
        export WAYLAND_DISPLAY=wayland-1
    fi

    : > "$SESSION_LOG"
    PYTHONUNBUFFERED=1 setsid nohup waydroid session start \
        > "$SESSION_LOG" 2>&1 < /dev/null 9>&- &
    ready_deadline=$((SECONDS + READY_TIMEOUT))
    fi

    # Probe time counts towards readiness, rather than multiplying the timeout
    # by the duration of an unresponsive Android IPC call on every iteration.
    while (( SECONDS < ready_deadline )); do
        if android_ready "$((ready_deadline - SECONDS))"; then
            echo "session ready"
            # One-time install of the bundled app suite (store, browser,
            # file manager — preseeded by rootfs/preseed-apks.py). Runs as
            # the session user: `waydroid app ...` fails under root (spike
            # F5). Stamped so it never reruns.
            local apk_stamp="$LOG_DIR/.apks-installed"
            if [[ -d /etc/windroid/apks && ! -e "$apk_stamp" ]]; then
                local all_ok=true
                for apk in /etc/windroid/apks/*.apk; do
                    [[ -e "$apk" ]] || continue
                    local pkg; pkg="$(basename "$apk" .apk)"
                    echo "installing bundled app: $pkg"
                    waydroid app install "$apk" || true
                    # `app install` can return before PackageManager commits;
                    # a session stop right after (e.g. the installer's smoke
                    # test) aborts the biggest APK (zip-test finding). Poll
                    # until the package is really there.
                    local ok=false
                    for _ in $(seq 45); do
                        if waydroid app list 2>/dev/null | grep -q "packageName: $pkg"; then ok=true; break; fi
                        sleep 1
                    done
                    if [[ "$ok" != "true" ]]; then
                        echo "WARN: bundled app did not install: $pkg" >&2
                        all_ok=false
                    fi
                done
                # Only stamp when everything landed — a partial first run
                # retries the missing ones next session.
                [[ "$all_ok" == "true" ]] && touch "$apk_stamp"
            fi
            # Windows Downloads share + Start Menu sync (both no-ops when
            # unconfigured / nothing changed).
            sudo -n /usr/local/sbin/windroid-prep share || true
            sudo -n systemctl start windroid-desktop-sync.service 2>/dev/null || true
            return 0
        fi
        sleep 1
    done
    echo "ERROR: Android framework not ready after ${READY_TIMEOUT}s — tail of $SESSION_LOG:" >&2
    tail -n 20 "$SESSION_LOG" >&2
    return 1
}

stop() {
    local weston_stopped=false
    waydroid session stop 2>/dev/null || true
    pkill -u "$(id -u)" -f 'weston --backend=wayland-backend' 2>/dev/null || true
    for _ in $(seq "$READY_TIMEOUT"); do
        if ! nested_weston_running; then
            weston_stopped=true
            break
        fi
        sleep 1
    done
    if [[ "$weston_stopped" != true ]]; then
        echo "ERROR: nested Weston did not stop after ${READY_TIMEOUT}s" >&2
    fi
    # Still attempt container shutdown if Weston did not exit.
    if ! sudo -n /usr/local/sbin/windroid-prep down; then
        echo 'ERROR: could not stop the Android container' >&2
        return 1
    fi
    [[ "$weston_stopped" == true ]] || return 1
    echo "stopped"
}

case "${1:-}" in
    start)  start ;;
    ensure) start ;;
    stop)   stop ;;
    status) waydroid status ;;
    *) echo "usage: windroid-session start|stop|status|ensure" >&2; exit 2 ;;
esac
